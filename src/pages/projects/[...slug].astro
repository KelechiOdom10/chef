---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";
import Link from "@components/Link.astro";
import ContactSection from "@components/ContactSection.astro";
import { Image } from "astro:assets";
import svgData from "@data/svgs.json";

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return projects.map(project => ({
    params: { slug: project.slug },
    props: project,
  }));
}
type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content } = await project.render();

const techStack = (project.data.technologies ?? []).map(label => {
  const tech = svgData.find(item => item.title.toLowerCase() === label.toLowerCase());
  const route = tech?.route;
  const sources = typeof route === "string"
    ? [{ src: route, theme: "" }]
    : route
      ? [{ src: route.light, theme: "block dark:hidden" }, { src: route.dark, theme: "hidden dark:block" }]
      : [];

  return {
    title: tech?.title ?? label,
    url: tech?.url,
    icons: sources.filter(icon => icon.src.startsWith("/tools/")),
  };
});
---

<PageLayout
  title={project.data.title}
  description={project.data.description}
  image={project.data.thumbnail?.src}
>
  <Container>
    {
      project.data.thumbnail && (
        <div
          transition:name={`project-image-${project.slug}`}
          class="mb-6 aspect-video overflow-hidden rounded-lg"
        >
          <Image
            src={project.data.thumbnail}
            alt={project.data.title}
            width={1200}
            height={600}
            loading="eager"
            fetchpriority="high"
            class="size-full object-cover object-top"
          />
        </div>
      )
    }
    <div class="animate">
      <BackToPrev href="/projects"> Back to projects </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <h1
        class="animate text-2xl lg:text-3xl font-semibold text-black dark:text-white"
      >
        {project.data.title}
      </h1>
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={project.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(project.body)}
        </div>
      </div>
      {
        project.data.description && (
          <p class="animate">{project.data.description}</p>
        )
      }
      {
        (project.data.demoURL || project.data.repoURL) && (
          <nav class="animate flex gap-1 font-semibold dark:text-white/90">
            {project.data.demoURL && (
              <Link href={project.data.demoURL} external>
                demo<span class="sr-only"> (opens in a new tab)</span>
              </Link>
            )}
            {project.data.demoURL && project.data.repoURL && <span>/</span>}
            {project.data.repoURL && (
              <Link href={project.data.repoURL} external>
                repo<span class="sr-only"> (opens in a new tab)</span>
              </Link>
            )}
          </nav>
        )
      }
    </div>
    <article class="animate">
      <Content />
    </article>
    {
      techStack.length > 0 && (
        <section class="animate space-y-6 mb-9" data-project-tech>
          <div class="flex flex-wrap gap-y-2 items-center justify-between">
            <h5 class="font-semibold text-black dark:text-white">Tech Stack</h5>
          </div>
          <ul class="flex flex-wrap gap-3">
            {techStack.map(tech => {
              const Tag = tech.url ? "a" : "span";
              return (
                <li>
                  <Tag
                    href={tech.url}
                    target={tech.url ? "_blank" : undefined}
                    rel={tech.url ? "noopener" : undefined}
                    class:list={[
                      "flex relative group py-1.5 px-2 items-center gap-2 no-underline rounded-lg border border-black/15 dark:border-white/20 w-fit",
                      tech.url && "hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out",
                    ]}
                  >
                    {tech.icons.map(icon => (
                      <img
                        class:list={["size-4 object-contain", icon.theme]}
                        width={16}
                        height={16}
                        src={icon.src}
                        alt=""
                      />
                    ))}
                    <span class="font-semibold text-sm text-black dark:text-white">
                      {tech.title}
                    </span>
                  </Tag>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }
    <ContactSection />
  </Container>
</PageLayout>
