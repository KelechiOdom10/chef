---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
  listing?: boolean;
}

const { entry, listing } = Astro.props;
const { title, description } = entry.data;
const thumbnail = listing && entry.collection === "projects" && entry.data.thumbnail;
---

<a
  href={`/${entry.collection}/${entry.slug}`}
  class:list={[
    "relative group flex flex-nowrap rounded-lg hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 transition-colors duration-300 ease-in-out",
    listing ? "items-center gap-3 py-3.5 pl-2 pr-9" : "py-3 px-4 pr-10 border border-black/15 dark:border-white/20",
  ]}
>
  {thumbnail && (
    <Image src={thumbnail} alt="" width={96} height={64} class="h-12 w-[4.5rem] shrink-0 rounded border border-black/10 object-cover object-top dark:border-white/15" />
  )}
  <div class="flex min-w-0 flex-1 flex-col">
    <span class="font-semibold">
      {title}
    </span>
    <div class:list={["text-sm", !listing && "truncate"]}>
      {description}
    </div>
  </div>
  <svg
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="absolute top-1/2 right-2 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current"
  >
    <line
      x1="5"
      y1="12"
      x2="19"
      y2="12"
      class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out"
    ></line>
    <polyline
      points="12 5 19 12 12 19"
      class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out"
    ></polyline>
  </svg>
</a>
